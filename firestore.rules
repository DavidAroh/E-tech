rules_version = '2';

// E-Tech — Cloud Firestore security rules
//
// All writes happen server-side via the Firebase Admin SDK from Next.js API
// routes (route handlers). The Admin SDK bypasses these rules entirely, so
// these rules exist to lock the collections down for any *direct* client
// access from the browser.
//
// Policy: the marketing site has no user authentication yet, so every
// collection is fully denied for client reads AND writes. Only the service
// account (Admin SDK) can write; nothing reads from the front-end.

service cloud.firestore {
  match /databases/{database}/documents {

    // Consultation requests (POST /api/consultation)
    match /consultations/{id} {
      allow read, write: if false;
    }

    // Newsletter subscribers (POST /api/newsletter)
    match /newsletter_subscribers/{id} {
      allow read, write: if false;
    }

    // Client assessment results (POST /api/assessment)
    match /assessment_results/{id} {
      allow read, write: if false;
    }

    // Professional-assessment lead capture (POST /api/assessment-lead)
    match /assessment_leads/{id} {
      allow read, write: if false;
    }
  }
}
